# Application routing
APP_ENV=development
PUBLIC_APP_URL=http://localhost:3000
API_PUBLIC_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000
VITE_API_BASE_URL=http://localhost:8000/api
VITE_BASE_PATH=/

# PostgreSQL
POSTGRES_USER=j_document_dms
POSTGRES_PASSWORD=replace_with_strong_postgres_password
POSTGRES_DB=j_document_dms
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql://j_document_dms:replace_with_strong_postgres_password@postgres:5432/j_document_dms

# Redis: broker, result backend, and cache use separate databases
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/2
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# MinIO: use separate root and application credentials
MINIO_ENDPOINT=minio:9000
MINIO_PUBLIC_ENDPOINT=
MINIO_SECURE=false
MINIO_PUBLIC_SECURE=true
MINIO_ROOT_USER=dms_minio_admin
MINIO_ROOT_PASSWORD=replace_with_strong_minio_root_password
MINIO_ACCESS_KEY=dms_application
MINIO_SECRET_KEY=replace_with_strong_minio_application_secret
MINIO_BUCKET_NAME=dms-documents
MINIO_CONSOLE_BIND_PORT=9001

# Authentication
JWT_SECRET=replace_with_secure_random_jwt_secret_at_least_64_characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
COOKIE_SECURE=false
ALLOW_MOCK_OAUTH=false

# GitHub OAuth application login
GITHUB_CLIENT_ID=your_github_oauth_client_id
GITHUB_CLIENT_SECRET=your_github_oauth_client_secret
GITHUB_REDIRECT_URI=http://localhost:8000/api/auth/github/callback
GITHUB_ALLOWED_USERS=your_github_username
GITHUB_ADMIN_USERS=your_github_username

# Optional Microsoft OAuth
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_TENANT_ID=common
MS_REDIRECT_URI=http://localhost:8000/api/auth/microsoft/callback

# UAT Traefik / deployment
APP_DOMAIN=uat-intranet.jibcomputer.group
API_DOMAIN=api-uat-intranet.jibcomputer.group
DMS_BASE_PATH=/j-document-dms
TRAEFIK_NETWORK=traefik_net
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERTRESOLVER=letsencrypt
TRAEFIK_PRIORITY=120
COMPOSE_PROJECT_NAME=j-document-dms-uat
